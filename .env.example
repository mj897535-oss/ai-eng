# ==============================================================================
# SyntaxLens Research Platform Environment Configuration Template
# COPY TO .env FOR LOCAL DEVELOPMENT. NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
APP_SECRET_KEY=change-this-in-production-to-a-64-char-random-secret
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=syntaxlens_user
POSTGRES_PASSWORD=syntaxlens_dev_password_only
POSTGRES_DB=syntaxlens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://syntaxlens_user:syntaxlens_dev_password_only@postgres:5432/syntaxlens
DATABASE_URL_SYNC=postgresql+psycopg2://syntaxlens_user:syntaxlens_dev_password_only@postgres:5432/syntaxlens

# --- Redis & Task Queue ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Object Storage (MinIO / S3 Private Bucket) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=syntaxlens_minio_admin
S3_SECRET_KEY=syntaxlens_minio_secret_key_123
S3_BUCKET_NAME=syntaxlens-audio
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PRESIGNED_EXPIRATION_SECONDS=900

# --- Email / SMTP (Mailpit in Dev) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@syntaxlens.edu
EMAILS_FROM_NAME=SyntaxLens Research Platform

# --- Speech & AI Provider Interfaces ---
# Options: "mock" (default, 0 API keys needed) or "real"
STT_PROVIDER=mock
LLM_PROVIDER=mock

# External API Keys (Optional - only required if provider is set to "real")
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# --- Security, Authentication & Session Tokens ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false # Set to true in production HTTPS
COOKIE_SAMESITE=lax

# --- Research Protocol Defaults (Frozen per Study Period) ---
DEFAULT_RUBRIC_VERSION=v1.0-jam-phd
DEFAULT_PROMPT_VERSION=v1.0-tutor-ladder
DEFAULT_MODEL_VERSION=mock-syntax-v1
DEFAULT_STT_VERSION=mock-stt-v1
MAX_COHORT_SIZE=120

# --- Phase P4 Participant & Protocol Settings ---
COLLECT_NAME=false
AGE_COLLECTION_MODE=band # "exact" or "band"
COLLECT_GEOGRAPHY=true
RESEARCH_CODE_PREFIX=SL-2026-
BLIND_STUDY_GROUP_FROM_PARTICIPANTS=true
CURRENT_CONSENT_VERSION=v1.0-jam-2026
